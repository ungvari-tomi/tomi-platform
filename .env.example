# API settings need no credentials; Azurite uses a generated emulator-only key.
# Copy to .env in the project root. The API loads .env when starting from that folder.
# PowerShell/process environment variables override .env values. Restart after edits.
RETAILFLOW_SEED=42
RETAILFLOW_INTERVAL_SECONDS=600
RETAILFLOW_DATASET_VERSION=orders-v3

# Generated in your ignored .env by: python -m retailflow.blob_storage init
# Do not put real Azure credentials here. This setup only connects to local Azurite.
AZURITE_ACCOUNT_KEY=

# Generated locally by: python -m retailflow.infrastructure init
# Keep actual values only in the ignored .env. Never commit or publish them.
AIRFLOW_DB_PASSWORD=
AIRFLOW_POSTGRES_ADMIN_PASSWORD=
RETAILFLOW_AIRFLOW_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=

# Optional read-only local monitor. It reuses RETAILFLOW_AIRFLOW_PASSWORD above.
RETAILFLOW_MONITOR_ORDERS_URL=http://127.0.0.1:18000
RETAILFLOW_MONITOR_AIRFLOW_URL=http://127.0.0.1:8080
RETAILFLOW_MONITOR_AIRFLOW_USERNAME=admin
RETAILFLOW_MONITOR_RUN_MAX_AGE_SECONDS=1800

# Host-only customer pseudonymization demo. Initialize using customer_ingestion init-key.
# Never place the actual key in Terraform variables, images, manifests or logs.
RETAILFLOW_CUSTOMER_PRIVACY_KEY=
RETAILFLOW_CUSTOMER_PRIVACY_KEY_ID=local-v1
